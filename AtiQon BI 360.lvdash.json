{
  "datasets": [
    {
      "name": "615d3c12",
      "displayName": "vw_fact_orders_enriched",
      "queryLines": [
        "SELECT * FROM fmcg.gold.vw_fact_orders_enriched"
      ],
      "columns": [
        {
          "displayName": "Avg Selling Price",
          "description": "Average selling price calculated as total revenue divided by total quantity sold",
          "expression": "SUM(`total_amount_inr`) / SUM(`sold_quantity`)"
        }
      ]
    },
    {
      "name": "top10_products_usd",
      "displayName": "Top 10 Products by Revenue (USD)",
      "queryLines": [
        "SELECT\n",
        "  product,\n",
        "  SUM(total_amount_inr) / 83.0 as revenue_usd\n",
        "FROM\n",
        "  vw_fact_orders_enriched\n",
        "GROUP BY\n",
        "  product\n",
        "ORDER BY\n",
        "  revenue_usd DESC\n",
        "LIMIT 10"
      ],
      "catalog": "fmcg",
      "schema": "gold"
    },
    {
      "name": "top_products_price_qty",
      "displayName": "Top Products - Price vs Quantity",
      "queryLines": [
        "SELECT\n",
        "  product,\n",
        "  SUM(sold_quantity) as total_quantity,\n",
        "  AVG(price_inr) as avg_price_inr\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "GROUP BY\n",
        "  product\n",
        "ORDER BY\n",
        "  total_quantity DESC\n",
        "LIMIT 15"
      ]
    }
  ],
